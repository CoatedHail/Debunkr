# Backend port
PORT=4000

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Anthropic API key — get one at https://console.anthropic.com
# OPTIONAL: when missing, backend uses a stub LLM analyzer (fixed score 75).
# Paste real key here, restart backend → real Claude takes over automatically.
ANTHROPIC_API_KEY=

# Claude model to use for content analysis
ANTHROPIC_MODEL=claude-haiku-4-5

# Google Fact Check Tools API key — optional; fact-check branch is disabled when empty
# Get from: https://console.cloud.google.com (enable "Fact Check Tools API", create API key)
GOOGLE_FACT_CHECK_API_KEY=

# Brave Search API key — optional; web-search branch disabled when empty
# Get from: https://api.search.brave.com (free tier 2k req/mo, no card)
BRAVE_SEARCH_API_KEY=
