# Backend port
PORT=4000

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Anthropic API key — get one at https://console.anthropic.com
# OPTIONAL: when missing, backend uses a stub LLM analyzer (fixed score 75).
# Paste real key here, restart backend → real Claude takes over automatically.
ANTHROPIC_API_KEY=

# Claude model to use for content analysis
ANTHROPIC_MODEL=claude-haiku-4-5
